{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archives 47",
  "mainBinaryName": "archives-47",
  "identifier": "com.lucaorion.archives47",
  "build": {
    "beforeDevCommand": "npm run archives:web",
    "devUrl": "http://127.0.0.1:1447/archives.html",
    "beforeBuildCommand": "npm run archives:build-web",
    "frontendDist": "../dist-archives"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Archives 47",
        "url": "archives.html",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 15 }
      }
    ],
    "security": {
      "capabilities": ["archives"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' blob: asset: http://asset.localhost ipc: http://ipc.localhost https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "script-src": "'self' blob: 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "frame-src": "https: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' blob: asset: ipc: http://ipc.localhost http: https: ws: wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "script-src": "'self' blob: 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "frame-src": "https: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**",
          "$APPDATA/repolens/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Archives 47 — an Orion Terminal app",
    "copyright": "© 2026 Luca Orion",
    "icon": [
      "icons-archives/32x32.png",
      "icons-archives/128x128.png",
      "icons-archives/128x128@2x.png",
      "icons-archives/icon.icns",
      "icons-archives/icon.png"
    ],
    "resources": [
      "../resources/website-cloner-scaffold",
      "../scripts/cursor-agent.mjs",
      "../scripts/cursor-options.mjs",
      "../scripts/cursor-sdk.mjs",
      "../LICENSE",
      "../NOTICE",
      "../THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES",
      "../THIRD_PARTY_SOURCES",
      "../resources/distribution-license-manifest.json",
      "../dist-archives/licenses"
    ],
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.archives.plist"
    }
  }
}
