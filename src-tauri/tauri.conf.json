{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion Terminal",
  "version": "0.1.0",
  "identifier": "com.lucaorion.orion-terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orion Terminal",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "script-src": "'self' blob: 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "worker-src": "'self' blob:",
        "frame-src": "http: https: about:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http: https: ws: wss:",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "script-src": "'self' blob: 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "worker-src": "'self' blob:",
        "frame-src": "http: https: about:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**",
          "$APPDATA/com.lucaorion.orion-terminal/assets/**",
          "$APPDATA/wallpapers/**",
          "$APPDATA/com.lucaorion.orion-terminal/wallpapers/**",
          "$APPDATA/characters/**",
          "$APPDATA/com.lucaorion.orion-terminal/characters/**",
          "$APPDATA/repolens/**",
          "$APPDATA/com.lucaorion.orion-terminal/repolens/**",
          "$APPDATA/command-center/**",
          "$APPDATA/com.lucaorion.orion-terminal/command-center/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../resources/website-cloner-scaffold", "../scripts/cursor-agent.mjs"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
