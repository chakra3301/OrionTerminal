{
  "name": "orion-terminal",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:bridges": "node --test scripts/*.test.mjs",
    "test:native": "cd src-tauri && cargo test --locked --lib",
    "verify": "npm run typecheck && npm test && npm run test:bridges && npm run build && npm run test:native",
    "doctor": "node scripts/doctor.mjs",
    "sync:fx-tools": "node scripts/sync-fx-tools.mjs",
    "sync:preview-csp": "node scripts/sync-preview-csp.mjs",
    "sync:pptx-browser": "node scripts/sync-pptx-browser.mjs",
    "licenses:prepare": "python3 scripts/sync-license-materials.py",
    "licenses:check": "node scripts/check-distribution-licenses.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high && npm audit --omit=dev --audit-level=high --prefix resources/cursor-runtime",
    "audit:all": "npm audit && npm audit --prefix resources/cursor-runtime",
    "audit:native": "cd src-tauri && cargo audit",
    "audit:native:target": "node scripts/audit-native.mjs",
    "test:native-policy": "node scripts/mcp-policy-smoke.mjs",
    "optimize:characters": "node scripts/optimize-characters.mjs"
  },
  "dependencies": {
    "@blocknote/mantine": "^0.39.1",
    "@blocknote/react": "^0.39.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "@huggingface/transformers": "4.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.3.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.475.0",
    "monaco-editor": "0.56.0",
    "polygon-clipping": "^0.15.7",
    "jszip": "3.10.1",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "react-hotkeys-hook": "^4.6.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "ulid": "^2.3.0",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "monaco-editor": { "dompurify": "3.4.15" },
    "@blocknote/core": { "uuid": "11.1.1" },
    "@connectrpc/connect-node": { "undici": "6.28.1" },
    "@huggingface/transformers": { "sharp": "0.35.4" },
    "onnxruntime-node": { "adm-zip": "0.6.1" }
  },
  "engines": { "node": ">=22.13.0" },
  "devDependencies": {
    "@cursor/sdk": "1.0.31",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
